# Copy this file to `.env` and fill in the values.
# Bun automatically loads `.env` — no extra tooling needed.

# OpenRouter API key, used when the `ai` / `ask` commands are run with
# --openrouter (or BETTERPROPOSALS_PROVIDER=openrouter). Get one at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
