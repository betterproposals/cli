# Copy this file to `.env` and fill in the values.
# Bun automatically loads `.env` — no extra tooling needed.

# OpenRouter API key, used when the `ai` / `ask` commands are run with
# --openrouter (or BETTERPROPOSALS_PROVIDER=openrouter). Get one at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Hosted MCP server (`bun run start:http`), not used by the local CLI.
# All of these are required except where marked optional. Never commit values.
# ---------------------------------------------------------------------------

# Public origin of this server. The MCP endpoint is <this>/mcp, and the main
# app's OAUTH_MCP_RESOURCE must be exactly that URL.
# MCP_PUBLIC_URL=https://mcp.example.com

# The main app that signs users in (its OAUTH_ISSUER), announced to clients.
# OAUTH_ISSUER=https://app.example.com

# The main app's token swap endpoint. It can be a private address.
# OAUTH_SWAP_URL=https://app.example.com/oauth/internal/swap

# Credential sent to the swap endpoint, at least 32 characters. Must equal the
# main app's OAUTH_SWAP_SECRET.
# OAUTH_SWAP_SECRET=

# Optional: extra headers for the swap request, as a JSON object, for example
# when the endpoint is reached over a private plain-HTTP route.
# OAUTH_SWAP_HEADERS={"X-Forwarded-Proto":"https"}

# API base URL (defaults to the production API) and optional extra headers
# for every API request, as a JSON object.
# BP_API_URL=https://api.example.com
# BP_API_HEADERS={"Host":"api.example.com"}

# Optional: largest tool answer in characters (default 100000, minimum 1000). A larger
# answer is replaced by a message that asks the model to narrow the request.
# MCP_MAX_RESULT_CHARS=100000

# Optional: requests per user per minute (default 120, 0 switches the limit off).
# Beyond it the server answers 429 with a Retry-After header.
# MCP_RATE_LIMIT_PER_MINUTE=120

# Optional: comma separated names of tools to switch off, for example
# documents_edit,documents_block_pricing. A name that is not a tool stops the server
# at startup. Tools not listed stay on, new ones included.
# MCP_DISABLED_TOOLS=

# Optional: listen port (default 3000).
# PORT=3000
